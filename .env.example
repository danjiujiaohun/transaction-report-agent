# ===== LLM 配置 =====
# 默认使用本地  OpenAI 兼容接口，改 LLM_PROVIDER 即可。
LLM_PROVIDER=openai            # openai


# OpenAI 兼容接口（DeepSeek / Qwen / OpenAI 等）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# ===== 联网搜索 =====
# 首选：Tavily（标准 HTTP API，只需 key，跨环境可移植，推荐）
TAVILY_API_KEY=

# 备选：AutoGLM WebSearch（依赖本地 53699 token 服务，可留空不用）
WEBSEARCH_TOKEN_URL=http://127.0.0.1:53699/get_token
WEBSEARCH_API_URL=https://autoglm-api.zhipuai.cn/agentdr/v1/assistant/skills/web-search
WEBSEARCH_APP_ID=100003
WEBSEARCH_APP_KEY=38d2391985e2369a5fb8227d8e6cd5e5

# ===== Skills 目录（markdown 规则文件）=====
SKILLS_DIR=skills

# ===== 美股取数 =====
# Yahoo/SEC 在部分网络直连会被 403/限流；配置后仅美股流量走该代理，A 股源不受影响。
# 本机跑 Clash 时示例：US_STOCK_PROXY=http://127.0.0.1:7890；服务器可直连则留空。
US_STOCK_PROXY=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000